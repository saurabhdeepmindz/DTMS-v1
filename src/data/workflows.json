    "parameters": [],
    "actions": {
      "81853e1f-478f-423a-8b40-47bf33fad812": {
        "id": "81853e1f-478f-423a-8b40-47bf33fad812",
        "name": "Build Welcome Email",
        "next": "df5bbe83-2ad3-4d7b-8513-4dab060a814f",
        "type": "create-variable",
        "description": "Build the email content from the sign up event.",
        "variableName": "email_content",
        "variableType": "object",
        "variableValue": {
          "code": "const user = context.event?.user || {};\nconst name = user.name || 'there';\nconst email = String(user.email || '');\nconst subject = 'Welcome!';\n\nconst text = [\n  `Hi ${name},`,\n  '',\n  'Welcome to our app.',\n  'We are excited to have you here.',\n].join('\\n');\n\nconst html = `<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  </head>\n  <body style=\"margin:0;padding:0;background:#f6f7fb;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f7fb;padding:24px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px;max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(16,24,40,.08);\">\n            <tr>\n              <td style=\"padding:24px;\">\n                <h1 style=\"margin:0 0 12px 0;font-size:22px;line-height:1.2;color:#101828;\">Welcome, ${name}</h1>\n                <p style=\"margin:0;font-size:16px;line-height:1.6;color:#344054;\">We are excited to have you here.</p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>`;\n\nreturn { to: email, subject, text, html };",
          "__wwtype": "js"
        },
        "__wwdescription": "<p>Build the welcome email HTML and text content using <code>context.event.user</code>.</p><p>Tip: customize this content to match your brand and onboarding flow.</p>"
      },
